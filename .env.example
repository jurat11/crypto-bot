# Copy this file to .env and fill it in. .env is gitignored: never commit it or paste it anywhere.
# The bot reads these values but never prints or logs them.

# Binance Spot Testnet: fake funds, real order placement. See README "Getting testnet keys".
TESTNET=1
TESTNET_API_KEY=
TESTNET_API_SECRET=

# Optional Telegram alerts (every trade, every risk block, daily 00:15 UTC leaderboard).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional dashboard address. The STOP button has no login, so keep it on this computer.
# HOST=127.0.0.1
# PORT=8000
