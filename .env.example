# Copy this file to .env and fill it in. .env is gitignored: never commit it or paste it anywhere.
# The bot reads these values but never prints or logs them.

# Binance Spot Testnet: fake funds, real order placement. See README "Getting testnet keys".
TESTNET=1
TESTNET_API_KEY=
TESTNET_API_SECRET=

# Optional Telegram alerts (every trade, every risk block, daily 00:15 UTC leaderboard).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional dashboard password (HTTP Basic auth, any user name). Set it whenever the dashboard
# can be reached from another computer, e.g. on a cloud server.
DASHBOARD_PASSWORD=

# Optional dashboard address. Keep 127.0.0.1 unless you also set DASHBOARD_PASSWORD.
# HOST=127.0.0.1
# PORT=8000
